# 由 scripts/setup.ps1 生成 .env 时会填入随机本地凭证；本文件只作示例，不包含真实密钥。
DB_PASSWORD=
DB_ROOT_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:8080
# 默认代理不可达时改用 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct

# 课程网关（兼容 OpenAI 接口）：嵌入与对话都只在服务端调用，密钥不下发浏览器。
# 两个通道可以指向不同服务：嵌入走 EMBEDDING_BASE_URL，对话走 CHAT_BASE_URL；
# 未单独填写时回退到 GATEWAY_BASE_URL 与 GATEWAY_API_KEY。
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE_ID=gateway-embedding-v1
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
GATEWAY_TIMEOUT=30s

# 向量库集合名固定为课程规约中的 campusclaw_chunks。
QDRANT_COLLECTION=campusclaw_chunks

# 种子材料导入：Compose 默认打开，示例班级名可改。
SEED_ENABLED=true
SEED_CLASS_NAME=示例班级

# 自建 MCP 工具服务（第 6 课）：同一个令牌由 mcp-demo 与 api 共用，
# 只经环境变量注入，不写进代码、镜像与前端。
MCP_AUTH_TOKEN=
# 工具服务的内部 Base URL（api 与 worker 经 Compose 内网访问）。
MCP_BASE_URL=http://mcp-demo:8090
# 服务器级令牌的加密密钥（32 字节以上的随机串）；未配置时只允许使用 MCP_AUTH_TOKEN。
TOOL_SECRET_KEY=
# 工具调用的上限（验收时可调小以观察降级）。
CHAT_MAX_TOOL_ROUNDS=3
CHAT_MAX_TOOL_CALLS=4
